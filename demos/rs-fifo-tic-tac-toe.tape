Output docs/assets/games/rs-fifo-tic-tac-toe.gif
Set Shell "bash"
Set FontSize 14
Set Width 900
Set Height 520
Set Padding 10
Set TypingSpeed 0
Hide
Type "clear && games/rs-fifo-tic-tac-toe/target/release/rs-fifo-tic-tac-toe --lang en replay games/rs-fifo-tic-tac-toe/examples/records/t3-k3-x-wins.fttrec --interval 900"
Enter
Sleep 300ms
Show
Sleep 20.5s
